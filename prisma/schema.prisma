generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────

enum UserRole {
  FOUNDER
  ADMIN
  SPONSOR
  INVITEE
}

enum InvitationStatus {
  DRAFT
  READY
  SENT
  VIEWED
  CLICKED
}

enum IntroMode {
  SELF_SEND
  THREE_WAY_INTRO
  DRAFT_FOR_APPROVAL
}

enum CTAResponse {
  INTERESTED
  MORE_DETAILS
  NOT_NOW
  NO_RESPONSE
}

enum PriorityTier {
  A
  B
  C
}

enum CommitmentStage {
  VERBAL_INTEREST
  SOFT_CIRCLE
  COMMITTED
  DOCS_SENT
  DOCS_SIGNED
  WIRED
  FUNDED
  DECLINED
}

enum MeetingStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum MessageType {
  SPONSOR_ASK
  INVITATION
  FOLLOW_UP
  MEETING_CONFIRM
  MEETING_RECAP
  CLOSING
  NURTURE
  CUSTOM
}

enum MessageChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum ContentBlockType {
  SOCIAL_PROOF
  WHY_NOW
  WHAT_WE_DO
  CREDIBILITY
  TRACTION
  TEAM
  ROUND_DETAILS
  FAQ
  FOUNDER_STORY
}

enum FounderRecommendation {
  RESPOND_NOW
  SCHEDULE_CALL
  SEND_DETAILS
  FOLLOW_UP
  WAIT
  NURTURE
  CLOSE
}

// ── Auth Models ────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  phone         String?
  role          UserRole
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  sponsor  Sponsor?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ── Domain Models ──────────────────────────────────────

model Sponsor {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  accessToken      String    @unique @default(cuid())
  company          String?
  title            String?
  investedAmount   Decimal?  @db.Decimal(12, 2)
  relationshipNote String?
  isActivated      Boolean   @default(false)
  activatedAt      DateTime?
  lastActiveAt     DateTime?

  invitees            Invitee[]
  communicationEvents CommunicationEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sponsors")
}

model Invitee {
  id                   String        @id @default(cuid())
  sponsorId            String
  sponsor              Sponsor       @relation(fields: [sponsorId], references: [id])
  accessToken          String        @unique @default(cuid())
  name                 String
  email                String
  phone                String?
  geography            String?
  estimatedCheckSize   Decimal?      @db.Decimal(12, 2)
  relationshipStrength Int?          @db.SmallInt
  isTopPick            Boolean       @default(false)
  introMode            IntroMode     @default(DRAFT_FOR_APPROVAL)
  sponsorNote          String?
  founderNote          String?

  ctaResponse    CTAResponse @default(NO_RESPONSE)
  ctaRespondedAt DateTime?
  ctaCheckSize   Decimal?    @db.Decimal(12, 2)

  heatScore              Float                  @default(0)
  priorityTier           PriorityTier           @default(C)
  tierOverride           PriorityTier?
  recommendation         FounderRecommendation?
  recommendationOverride FounderRecommendation?

  duplicateOfId String?
  duplicateOf   Invitee?  @relation("DuplicateGroup", fields: [duplicateOfId], references: [id])
  duplicates    Invitee[] @relation("DuplicateGroup")

  status String @default("new")

  invitation          Invitation?
  dealRoomViews       DealRoomView[]
  meetings            Meeting[]
  commitment          Commitment?
  communicationEvents CommunicationEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([heatScore(sort: Desc)])
  @@index([priorityTier])
  @@map("invitees")
}

model Invitation {
  id           String           @id @default(cuid())
  inviteeId    String           @unique
  invitee      Invitee          @relation(fields: [inviteeId], references: [id])
  status       InvitationStatus @default(DRAFT)
  channel      MessageChannel   @default(EMAIL)
  subject      String?
  body         String           @db.Text
  personalNote String?          @db.Text
  templateId   String?
  template     MessageTemplate? @relation(fields: [templateId], references: [id])
  sentAt       DateTime?
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invitations")
}

model DealRoomView {
  id           String   @id @default(cuid())
  inviteeId    String
  invitee      Invitee  @relation(fields: [inviteeId], references: [id])
  viewedAt     DateTime @default(now())
  durationSecs Int?
  scrollDepth  Float?
  deviceType   String?
  ipAddress    String?
  userAgent    String?

  @@index([inviteeId])
  @@index([viewedAt])
  @@map("deal_room_views")
}

model Meeting {
  id              String        @id @default(cuid())
  inviteeId       String
  invitee         Invitee       @relation(fields: [inviteeId], references: [id])
  status          MeetingStatus @default(SCHEDULED)
  scheduledAt     DateTime
  durationMinutes Int           @default(30)
  meetingLink     String?
  notes           String?       @db.Text
  nextSteps       String?       @db.Text
  confirmedAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduledAt])
  @@map("meetings")
}

model Commitment {
  id            String          @id @default(cuid())
  inviteeId     String          @unique
  invitee       Invitee         @relation(fields: [inviteeId], references: [id])
  stage         CommitmentStage @default(VERBAL_INTEREST)
  amount        Decimal?        @db.Decimal(12, 2)
  currency      String          @default("USD")
  vehicle       String?
  valuation     String?
  docsSentAt    DateTime?
  docsSignedAt  DateTime?
  fundedAt      DateTime?
  declinedAt    DateTime?
  declineReason String?

  closingTasks ClosingTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("commitments")
}

model ClosingTask {
  id           String     @id @default(cuid())
  commitmentId String
  commitment   Commitment @relation(fields: [commitmentId], references: [id])
  title        String
  description  String?
  isCompleted  Boolean    @default(false)
  completedAt  DateTime?
  dueDate      DateTime?
  sortOrder    Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("closing_tasks")
}

model CommunicationEvent {
  id        String         @id @default(cuid())
  inviteeId String?
  invitee   Invitee?       @relation(fields: [inviteeId], references: [id])
  sponsorId String?
  sponsor   Sponsor?       @relation(fields: [sponsorId], references: [id])
  type      MessageType
  channel   MessageChannel
  direction String
  subject   String?
  body      String?        @db.Text
  metadata  Json?
  sentAt    DateTime       @default(now())

  createdAt DateTime @default(now())

  @@index([inviteeId])
  @@index([sponsorId])
  @@index([sentAt])
  @@map("communication_events")
}

// ── Configuration Models ───────────────────────────────

model RoundSettings {
  id                     String   @id @default(cuid())
  isActive               Boolean  @default(true)
  roundName              String   @default("Angel Round")
  targetAmount           Decimal  @db.Decimal(12, 2)
  raisedToDate           Decimal  @default(0) @db.Decimal(12, 2)
  minCheckSize           Decimal? @db.Decimal(12, 2)
  maxCheckSize           Decimal? @db.Decimal(12, 2)
  vehicle                String   @default("SAFE")
  valuationCap           String?
  sprintStartDate        DateTime
  sprintEndDate          DateTime
  sponsorGoal            Int      @default(10)
  inviteeGoal            Int      @default(70)
  companyName            String   @default("Vento")
  companyTagline         String?  @default("The Revenue Logic Brain")
  founderName            String   @default("Ofir")
  founderEmail           String?
  founderCalendarLink    String?
  showAllocationProgress Boolean  @default(true)
  showUrgencyLanguage    Boolean  @default(true)
  complianceNote         String?  @db.Text
  confidentialityText    String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("round_settings")
}

model ContentBlock {
  id        String           @id @default(cuid())
  type      ContentBlockType
  title     String
  body      String           @db.Text
  metadata  Json?
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@map("content_blocks")
}

model MessageTemplate {
  id        String      @id @default(cuid())
  type      MessageType
  name      String
  subject   String?
  body      String      @db.Text
  variables Json?
  isDefault Boolean     @default(false)
  isActive  Boolean     @default(true)

  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("message_templates")
}

model AutomationRule {
  id           String  @id @default(cuid())
  name         String
  description  String?
  trigger      String
  conditions   Json
  action       String
  actionData   Json?
  delayMinutes Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("automation_rules")
}

model FounderAlert {
  id          String    @id @default(cuid())
  type        String
  title       String
  description String?
  metadata    Json?
  inviteeId   String?
  isRead      Boolean   @default(false)
  readAt      DateTime?

  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
  @@map("founder_alerts")
}
